{
  "expo": {
    "name": "Habits",
    "slug": "habits",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "habits",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.raulgardini.habits",
      "entitlements": {
        "com.apple.security.application-groups": ["group.com.raulgardini.habits"]
      },
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#4f46e5",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.raulgardini.habits",
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "headers": {
            "Cross-Origin-Embedder-Policy": "credentialless",
            "Cross-Origin-Opener-Policy": "same-origin"
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#f5f5f7",
          "dark": {
            "image": "./assets/images/splash-icon.png",
            "backgroundColor": "#0e0e11"
          }
        }
      ],
      "expo-sqlite",
      "expo-sharing",
      "expo-notifications",
      "@bacons/apple-targets",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "Today",
              "label": "Hábitos de hoje",
              "description": "Marque seus hábitos direto da tela inicial",
              "minWidth": "250dp",
              "minHeight": "180dp",
              "targetCellWidth": 4,
              "targetCellHeight": 3,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000,
              "previewImage": "./assets/images/widget-today-preview.png"
            },
            {
              "name": "Heatmap",
              "label": "Mapa de hábitos",
              "description": "Suas últimas semanas em um mapa de calor",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000,
              "previewImage": "./assets/images/widget-heatmap-preview.png"
            }
          ]
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "reactCompiler": true
    },
    "description": "Hábitos e agenda gratuitos, sem anúncios e que funcionam offline.",
    "extra": {
      "router": {
        "headers": {
          "Cross-Origin-Embedder-Policy": "credentialless",
          "Cross-Origin-Opener-Policy": "same-origin"
        }
      },
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "bundleIdentifier": "com.raulgardini.habits.widget",
                  "targetName": "HabitsWidget",
                  "entitlements": {
                    "com.apple.security.application-groups": ["group.com.raulgardini.habits"]
                  }
                }
              ]
            }
          }
        },
        "projectId": "3385e27a-523e-4825-8445-9d29b6930236"
      }
    },
    "owner": "raulgardini",
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/3385e27a-523e-4825-8445-9d29b6930236"
    }
  }
}
